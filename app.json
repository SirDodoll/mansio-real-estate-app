{
  "expo": {
    "name": "Mansio",
    "slug": "mansio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/mansio.png",
    "scheme": "mansio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/mansio.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon/mansio-transparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mansio"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/mansio.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icon/mansio-splash.png",
          "imageWidth": 240
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
